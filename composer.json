{
  "name": "your-vendor/amezmo-cli",
  "description": "Unofficial community CLI for the Amezmo API",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "symfony/console": "^7.3",
    "symfony/filesystem": "^7.3",
    "symfony/http-client": "^7.3",
    "symfony/mime": "^7.3",
    "symfony/string": "^7.3",
    "symfony/yaml": "^7.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.75",
    "phpunit/phpunit": "^11.5",
    "humbug/box": "^4.6",
    "fidry/filesystem": "1.2.3",
    "symfony/event-dispatcher": "^7.3",
    "symfony/options-resolver": "^7.3",
    "symfony/stopwatch": "^7.3"
  },
  "autoload": {"psr-4": {"AmezmoCli\\": "src/"}},
  "autoload-dev": {"psr-4": {"AmezmoCli\\Tests\\": "tests/"}},
  "bin": ["bin/amezmo-cli"],
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "lint": "php-cs-fixer fix --dry-run --diff",
    "build": "box compile",
    "verify-phar": "php build/amezmo-cli.phar --version && php build/amezmo-cli.phar list"
  },
  "config": {"sort-packages": true, "allow-plugins": {"php-http/discovery": true}}
}
